# IGDB API credentials (get from https://dev.twitch.tv)
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# Paths (override these if not using the default docker-compose.yml)
ROM_PATH=/roms
DATA_PATH=/data

# Timezone
TZ=America/New_York

# Firebase Auth (backend)
# Drop your service account JSON at /mnt/user/appdata/rom-archiver/firebase-credentials.json
# The container maps that folder to /data, so no extra volume needed.
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS=/data/firebase-credentials.json

# Firebase Auth (frontend) — Firebase Console → Project Settings → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=rom-archiver.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rom-archiver
VITE_FIREBASE_STORAGE_BUCKET=rom-archiver.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
